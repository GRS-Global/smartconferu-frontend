# Data source for My Conferences: "supabase" (default) or "mock" (typed fixtures in src/mocks, UI work only).
# There is no automatic fallback to mock data.
NEXT_PUBLIC_DATA_SOURCE=supabase

# Same project as the prototype's VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY. The anon key is public by
# design (Row Level Security protects the data). NEVER put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Vite prototype, for screens not yet ported (create-conference, CFP, certificates, ...).
NEXT_PUBLIC_PROTOTYPE_URL=http://localhost:5173

# Google Maps (the venue picker on Create Conference, phase P5). Same key as the prototype's VITE_GOOGLE_MAPS_API_KEY.
# It is compiled into the page, so restrict it to this site's address in the Google Cloud console. Optional until P5.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

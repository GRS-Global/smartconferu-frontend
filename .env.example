# Data source: "supabase" (default), "mock" (typed fixtures in src/mocks, UI work only) or "api" (own backend, see NEXT_PUBLIC_API_URL below).
# There is no automatic fallback to mock data.
NEXT_PUBLIC_DATA_SOURCE=supabase   # supabase | mock | api

# Same project as the prototype's VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY. The anon key is public by
# design (Row Level Security protects the data). NEVER put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Vite prototype, for screens not yet ported (create-conference, CFP, certificates, ...).
NEXT_PUBLIC_PROTOTYPE_URL=http://localhost:5173

# Google Maps (the venue picker on Create Conference, phase P5). Same key as the prototype's VITE_GOOGLE_MAPS_API_KEY.
# It is compiled into the page, so restrict it to this site's address in the Google Cloud console. Optional until P5.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Own backend (Backend/, NestJS). Use NEXT_PUBLIC_DATA_SOURCE=api to talk to it instead of Supabase.
# Base URL only: no trailing slash, no /api/v1 (added by src/lib/api-client.ts). Backend default port is 3000, so run Next on another port (e.g. 3100).
# The backend's CORS_ORIGINS (Backend/.env) must contain this app's origin, e.g. http://localhost:3100.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Terms of Service version sent with sign-up (the backend records it). Optional.
NEXT_PUBLIC_TERMS_VERSION=2026-10-01
